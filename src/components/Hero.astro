---
import Button from './Button.astro';

interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  showImage?: boolean;
}

const { 
  title, 
  subtitle, 
  ctaText = 'Book Free Consultation', 
  ctaLink = '#contact',
  secondaryCtaText,
  secondaryCtaLink,
  showImage = true
} = Astro.props;
---

<section class="relative bg-gradient-to-br from-purple-50 to-orange-50 overflow-hidden">
  <div class="container-custom section-padding">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="space-y-6">
        <h1 class="text-gradient leading-tight">
          {title}
        </h1>
        <p class="text-xl text-gray-700 leading-relaxed">
          {subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <Button href={ctaLink} variant="primary">
            {ctaText}
          </Button>
          {secondaryCtaText && secondaryCtaLink && (
            <Button href={secondaryCtaLink} variant="secondary">
              {secondaryCtaText}
            </Button>
          )}
        </div>
      </div>

      <!-- Image -->
      {showImage && (
        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src="https://www.eaglesmart.rs/wp-content/themes/zerif-lite/images/gordana-panajotovic.jpg"
              alt="Gordana Panajotović - Executive Coach"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Decorative Elements -->
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-orange-500 rounded-full opacity-20 blur-2xl"></div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-purple-700 rounded-full opacity-20 blur-2xl"></div>
        </div>
      )}
    </div>
  </div>
</section>
