---
interface Props {
  quote: string;
  author: string;
  role: string;
  company?: string;
}

const { quote, author, role, company } = Astro.props;
---

<div class="card">
  <!-- Quote Icon -->
  <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
    <svg class="w-6 h-6 text-purple-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
    </svg>
  </div>

  <!-- Quote -->
  <p class="text-gray-700 text-lg italic leading-relaxed mb-6">
    "{quote}"
  </p>

  <!-- Author Info -->
  <div class="border-t border-gray-200 pt-4">
    <p class="font-semibold text-purple-900">{author}</p>
    <p class="text-gray-600 text-sm">
      {role}{company && `, ${company}`}
    </p>
  </div>
</div>
