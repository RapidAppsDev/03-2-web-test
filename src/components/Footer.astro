---
const currentYear = new Date().getFullYear();
---

<footer class="bg-purple-900 text-white mt-auto">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-xl font-heading font-bold mb-4">Gordana Panajotović</h3>
        <p class="text-purple-200 text-sm">
          Executive Coach helping HR leaders drive strategic business impact through proven coaching methodologies.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-heading font-bold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-purple-200 hover:text-white transition-colors">Home</a>
          </li>
          <li>
            <a href="/about" class="text-purple-200 hover:text-white transition-colors">About</a>
          </li>
          <li>
            <a href="/services" class="text-purple-200 hover:text-white transition-colors">Coaching Services</a>
          </li>
          <li>
            <a href="#contact" class="text-purple-200 hover:text-white transition-colors">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xl font-heading font-bold mb-4">Get in Touch</h3>
        <ul class="space-y-2 text-purple-200 text-sm">
          <li>
            <a href="mailto:office@eaglesmart.rs" class="hover:text-white transition-colors">
              office@eaglesmart.rs
            </a>
          </li>
          <li>
            <a href="tel:+381660713133" class="hover:text-white transition-colors">
              +381 66 07 13 13
            </a>
          </li>
          <li class="pt-4">
            <a 
              href="https://www.linkedin.com/in/gordana-panajotovic/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-purple-800 mt-8 pt-8 text-center text-purple-200 text-sm">
      <p>&copy; {currentYear} Gordana Panajotović. All rights reserved.</p>
    </div>
  </div>
</footer>
