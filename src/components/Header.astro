---
import Button from './Button.astro';

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Coaching Services', href: '/services' },
  { name: 'Contact', href: '#contact' }
];
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <nav class="container-custom py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="text-2xl font-heading font-bold text-purple-900 hover:text-purple-700 transition-colors">
        Gordana Panajotović
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="text-gray-700 hover:text-purple-700 font-medium transition-colors"
          >
            {item.name}
          </a>
        ))}
        <Button href="#contact" variant="primary" class="ml-4">
          Book Consultation
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        class="md:hidden p-2 text-gray-700 hover:text-purple-700 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
      <div class="flex flex-col space-y-4">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class="text-gray-700 hover:text-purple-700 font-medium transition-colors py-2"
          >
            {item.name}
          </a>
        ))}
        <Button href="#contact" variant="primary" class="mt-2">
          Book Consultation
        </Button>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    
    if (button && menu) {
      button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>

<style>
  header {
    backdrop-filter: blur(10px);
    background-color: rgba(255, 255, 255, 0.95);
  }
</style>
